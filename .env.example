# Copie para ".env" (cp .env.example .env) e preencha. O .env NÃO vai para o GitHub.

# Senha do MySQL (invente uma forte)
DB_PASSWORD=troque-esta-senha

# Segredo que assina os logins. Gere um com:  openssl rand -hex 32
MENOS_JWT_SEGREDO=

# Endereço do site na Vercel que pode chamar a API. Vários, separados por vírgula, sem espaço.
# Ex.: https://menos.vercel.app
SITE_URL=https://menos.vercel.app
